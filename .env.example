# ============================================================
# .env.example  - 環境変数テンプレート
#
# ルール：
#   1. このファイルは git 管理する（チームで共有）
#   2. .env 本体は git 管理しない（.gitignore に追加済み）
#   3. 新しい環境変数を追加したら必ずここも更新する！
#   4. 実際の値は各自が .env にコピーして設定する
#
# セットアップ：
#   cp .env.example .env
#   .env を編集して実際の値を入力
# ============================================================

# --- アプリ共通 ---
APP_ENV=development          # development / production
LOG_LEVEL=DEBUG              # 本番は INFO に変更

# --- PostgreSQL ---
# ⚠️ compose.yaml の healthcheck と値を揃えてください
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://appuser:your_password_here@db:5432/appdb

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Next.js フロントエンド ---
NEXT_PUBLIC_API_URL=http://localhost:8000   # 本番は https://api.yourdomain.com

# --- OpenAI API（OCR + LLM） ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Firebase（認証） ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_CREDENTIALS_JSON=

#--- Firebase（service_account_key） ---
FIREBASE_CREDENTIALS_JSON=

# --- Stripe（決済） ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- メール送信（SendGrid） ---
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# --- Cloudinary（画像ストレージ） ---
CLOUDINARY_CLOUD_NAME=ここにCloud nameを貼る
CLOUDINARY_API_KEY=ここにAPI Keyを貼る
CLOUDINARY_API_SECRET=ここにAPI Secretを貼る

# --- OpenAI ---
OPENAI_API_KEY=ここにAPI Keyを貼る
OPENAI_MODEL=gpt-4o-mini